# JARVIS Environment Configuration
# Copy this file to .env and fill in your values

# Required: OpenHands API Key (get from https://openhands.dev)
LLM_API_KEY=your-api-key-here

# Optional: LLM Model (default: anthropic/claude-sonnet-4-5-20250929)
# LLM_MODEL=anthropic/claude-sonnet-4-5-20250929

# Optional: Voice language (default: en)
# VOICE_LANG=en